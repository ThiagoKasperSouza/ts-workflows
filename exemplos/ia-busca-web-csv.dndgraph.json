          "x": 280,
          "y": 52,
          "w": 250,
          "h": 108,
          "command": "QUERY=\"fluxo de trabalho em workflow\"; curl -s --max-time 20 -A \"Mozilla/5.0\" \"https://pt.wikipedia.org/w/api.php?action=query&list=search&srsearch=$(printf %s \"$QUERY\" | jq -sRr @uri)&format=json&srlimit=5\" -o /tmp/busca.json; RESULTADOS=$(jq '[.query.search[]?] | length' /tmp/busca.json); BUSCA=$(jq -r '[.query.search[]? | \"- \\(.title): \\(.snippet | gsub(\"<[^>]+>\"; \"\"))\"] | join(\"\\n\")' /tmp/busca.json); echo \"$RESULTADOS resultado(s) para: $QUERY\"; echo \"$BUSCA\"",
          "exposes": [
            "RESULTADOS",
            "BUSCA",
            "QUERY"
          ]
        },
        {
          "id": "dec_busca",
          "kind": "diamond",
          "label": "achou algo?",
          "x": 650,
          "y": 50,
          "w": 190,
          "h": 112,
          "condition": "RESULTADOS > 0"
        },
        {
          "id": "delegar",
          "kind": "terminal",
          "label": "gemma3 extrai CSV",
          "x": 980,
          "y": 40,
          "w": 250,
          "h": 120,
          "command": "MODELO=${OLLAMA_MODEL:-gemma3:4b}; PROMPT=\"Transforme a busca abaixo em CSV. Responda APENAS com o CSV, sem cerca de codigo, comecando pelo cabecalho resultado,resumo. Busca: $BUSCA\"; jq -n --arg m \"$MODELO\" --arg p \"$PROMPT\" '{model:$m, prompt:$p, stream:false, options:{num_predict:700, temperature:0.2}}' | curl -s --max-time 300 \"$OLLAMA_HOST/api/generate\" -d @- | jq -r '.response // \"\"' > /tmp/bruto.txt; CSV=$(sed -e '/^```/d' -e 's/^```//' -e 's/```$//' /tmp/bruto.txt | sed '/^[[:space:]]*$/d'); TAMANHO=${#CSV}; echo \"resposta do modelo: ${TAMANHO} caracteres\"; printf '%s\\n' \"$CSV\" | head -5",
          "exposes": [
            "CSV",
            "TAMANHO"
          ]
        },
        {
          "id": "dec_resposta",
          "kind": "diamond",
          "label": "modelo respondeu?",
          "x": 1350,
          "y": 44,
          "w": 200,
          "h": 112,
          "condition": "TAMANHO > 20"
        },
        {
          "id": "salvar",
          "kind": "terminal",
          "label": "salvar saida",
          "x": 1700,
          "y": 36,
          "w": 250,
          "h": 116,
          "command": "mkdir -p saida; printf '%s\\n' \"$CSV\" > saida/resultado.csv; { echo \"# Resultado da busca\"; echo; echo \"- Consulta: $QUERY\"; echo \"- Resultados na busca: $RESULTADOS\"; echo \"- Gerado por: ${OLLAMA_MODEL:-gemma3:4b} em $(date '+%Y-%m-%d %H:%M')\"; echo; echo '| resultado | resumo |'; echo '| --- | --- |'; tail -n +2 saida/resultado.csv | awk -F',' 'NF>1 {printf \"| %s | %s |\\n\", substr($0, 1, index($0, \",\")-1), substr($0, index($0, \",\")+1)}'; } > saida/resultado.md; LINHAS=$(wc -l < saida/resultado.csv | tr -d ' '); echo \"saida/resultado.csv: $LINHAS linha(s)\"; echo \"saida/resultado.md criado\"",
          "exposes": [
            "LINHAS"
          ]
        },
